{
  "name": "timebridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TimeBridge: an independent cross-time-zone booking UX concept (simulated availability; not affiliated with Cal.com).",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:e2e",
    "test:e2e:chromium": "playwright test --project=desktop-chromium --project=mobile-chromium",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/cal-sans": "5.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "6.4.4",
    "vitest": "5.0.4"
  }
}
